# Banco de dados PostgreSQL
DATABASE_URL="postgresql://sisgarage:sisgarage@localhost:5432/sisgarage?schema=public"

# Segredo para assinar a sessão (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-este-segredo"

# Pasta onde as fotos enviadas são gravadas
UPLOAD_DIR="./storage/uploads"

# URL pública do site (usada em links e SEO)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Consulta por placa (fase 5). Deixe vazio enquanto não houver provedor contratado.
PLATE_API_PROVIDER=""
PLATE_API_TOKEN=""
