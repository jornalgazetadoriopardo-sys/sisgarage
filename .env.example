# Banco MySQL/MariaDB.
# XAMPP (usuário root sem senha):  mysql://root:@localhost:3306/sisgarage
# Com usuário e senha:             mysql://usuario:senha@localhost:3306/sisgarage
DATABASE_URL="mysql://root:@localhost:3306/sisgarage"

# Segredo da sessão: troque por um texto longo e aleatório (mínimo 32 caracteres)
AUTH_SECRET="troque-por-um-texto-longo-e-aleatorio-com-32-caracteres"

# Fotos públicas (servidas em /uploads) e originais privados (para refazer a marca d'água)
UPLOAD_DIR="./storage/uploads"
ORIGINALS_DIR="./storage/originals"

# Endereço público do site (links, sitemap e compartilhamento no WhatsApp)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Primeiro administrador da plataforma (usado pelo "npm run db:seed")
ADMIN_EMAIL="admin@sisgarage.local"
ADMIN_PASSWORD="admin12345"

# Consulta por placa (fase 5). Deixe vazio enquanto não houver provedor contratado.
PLATE_API_PROVIDER=""
PLATE_API_TOKEN=""

# Somente na Vercel: criado automaticamente ao conectar um Vercel Blob ao projeto.
# Quando presente, as fotos vão para o Blob em vez do disco.
# BLOB_READ_WRITE_TOKEN=""

# Tabela FIPE (API pública gratuita). Só mude se for usar outro provedor com o mesmo formato.
# FIPE_API_URL="https://parallelum.com.br/fipe/api/v1"

# Protege a atualização mensal automática da FIPE (/api/cron/fipe, agendada no vercel.json)
CRON_SECRET=""
