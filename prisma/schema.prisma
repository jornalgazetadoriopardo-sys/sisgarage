// Banco: MySQL 8 / MariaDB 10.6+ (roda no XAMPP e em hospedagem cPanel).
// Collation utf8mb4_unicode_ci: buscas ignoram maiúsculas e acentos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
}

enum Role {
  SUPER_ADMIN // dono da plataforma
  STORE_OWNER // dono da loja
  STORE_STAFF // vendedor/funcionário da loja
}

enum StoreStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum VehicleType {
  CAR
  MOTORCYCLE
  TRUCK
  OTHER
}

enum Fuel {
  FLEX
  GASOLINE
  ETHANOL
  DIESEL
  ELECTRIC
  HYBRID
  GNV
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
  AUTOMATED
}

enum VehicleStatus {
  PREPARING // em preparação (não aparece no site)
  AVAILABLE // à venda
  RESERVED // reservado
  SOLD // vendido
}

enum PurchaseSource {
  PERSON // pessoa física
  DEALER // outra loja
  AUCTION // leilão
  TRADE_IN // troca
  OTHER
}

enum ExpenseCategory {
  MECHANICS
  BODYWORK
  TIRES
  DETAILING
  ELECTRICAL
  DISPATCHER // despachante
  TRANSFER // transferência
  INSPECTION // vistoria/laudo
  TRANSPORT
  COMMISSION
  OTHER
}

enum DocumentType {
  CRLV
  ATPV // recibo de compra e venda (ATPV-e)
  CAUTELAR // laudo cautelar
  INSPECTION // vistoria
  POWER_OF_ATTORNEY // procuração
  SPARE_KEY
  MANUAL
  OWNER_ID // documento do antigo proprietário
  OTHER
}

enum DocumentStatus {
  PENDING
  OK
  NOT_APPLICABLE
}

enum TaxKind {
  IPVA
  LICENSING
  FINE
  OTHER
}

enum SaleStatus {
  RESERVED // sinal pago, veículo reservado
  COMPLETED // venda concluída
  CANCELED
}

enum PaymentMethod {
  PIX
  CASH
  TRANSFER
  DEBIT_CARD
  CREDIT_CARD
  FINANCING
  TRADE_IN
  PROMISSORY
  OTHER
}

enum WatermarkPosition {
  BOTTOM_RIGHT
  BOTTOM_LEFT
  TOP_RIGHT
  TOP_LEFT
  CENTER
}

model User {
  id           String   @id @default(cuid())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(100)
  role         Role     @default(STORE_STAFF)
  active       Boolean  @default(true)
  storeId      String?
  store        Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
}

/// Tentativas de login, para limitar força bruta por e-mail e por IP.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(191)
  ip        String   @db.VarChar(64)
  success   Boolean
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

model Store {
  id           String      @id @default(cuid())
  name         String      @db.VarChar(100)
  slug         String      @unique @db.VarChar(120)
  cnpj         String?     @unique @db.VarChar(14)
  legalName    String?     @db.VarChar(150) // razão social (documentos)
  email        String      @db.VarChar(191)
  phone        String?     @db.VarChar(20)
  whatsapp     String?     @db.VarChar(20)
  instagram    String?     @db.VarChar(60)
  openingHours String?     @db.VarChar(200)
  zipCode      String?     @db.VarChar(8)
  address      String?     @db.VarChar(200)
  city         String      @db.VarChar(80)
  state        String      @db.Char(2)
  description  String?     @db.Text
  logoUrl      String?     @db.VarChar(255)
  status       StoreStatus @default(PENDING)

  // Marca d'água aplicada nas fotos (a partir do original guardado, então é reversível)
  watermarkEnabled  Boolean           @default(false)
  watermarkUrl      String?           @db.VarChar(255) // PNG com fundo transparente
  watermarkPosition WatermarkPosition @default(BOTTOM_RIGHT)
  watermarkSize     Int               @default(22) // % da largura da foto
  watermarkOpacity  Int               @default(80) // 10–100

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  vehicles  Vehicle[]
  leads     Lead[]
  customers Customer[]
  sales     Sale[]

  @@index([status])
  @@index([city, state])
}

model Vehicle {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  type            VehicleType   @default(CAR)
  brand           String        @db.VarChar(60)
  model           String        @db.VarChar(80)
  version         String?       @db.VarChar(140)
  yearManufacture Int           @db.SmallInt
  yearModel       Int           @db.SmallInt
  mileage         Int           @default(0)
  price           Decimal       @db.Decimal(12, 2)
  previousPrice   Decimal?      @db.Decimal(12, 2) // preço "De" riscado (só aparece se maior que o preço)
  color           String?       @db.VarChar(40)
  fuel            Fuel          @default(FLEX)
  transmission    Transmission  @default(MANUAL)
  doors           Int?          @db.TinyInt // só carro
  engine          String?       @db.VarChar(30) // motor (1.0, 2.0) ou cilindrada (160 cc)
  // Dados internos: nunca exibidos no site (só o último dígito da placa)
  plate           String?       @db.VarChar(7)
  renavam         String?       @db.VarChar(11)
  chassis         String?       @db.VarChar(17)
  description     String?       @db.Text
  status          VehicleStatus @default(PREPARING)
  published       Boolean       @default(false)
  featured        Boolean       @default(false)
  featuredLabel   String?       @db.VarChar(40) // texto do selo ("Único dono"); vazio = "Destaque"
  position        Int           @default(0) // ordem manual na vitrine da loja

  // ----- Gestão interna (fase 2) -----
  purchaseDate    DateTime?       @db.Date
  purchasePrice   Decimal?        @db.Decimal(12, 2)
  purchaseSource  PurchaseSource?
  purchaseFrom    String?         @db.VarChar(120) // de quem comprou
  purchasePayment String?         @db.VarChar(120) // como pagou
  purchaseNotes   String?         @db.Text
  fipeType        String?         @db.VarChar(12) // carros | motos | caminhoes
  fipeBrandCode   String?         @db.VarChar(12)
  fipeModelCode   String?         @db.VarChar(12)
  fipeYearCode    String?         @db.VarChar(12)
  fipeCode        String?         @db.VarChar(12)
  fipeName        String?         @db.VarChar(200)
  fipeValue       Decimal?        @db.Decimal(12, 2)
  fipeReference   String?         @db.VarChar(40) // "novembro de 2026"
  fipeCheckedAt   DateTime?
  views           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  photos      VehiclePhoto[]
  features    VehicleFeature[]
  leads       Lead[]
  expenses    VehicleExpense[]
  documents   VehicleDocument[]
  taxes       VehicleTax[]
  fipeHistory FipeHistory[]
  sales       Sale[]        @relation("SaleVehicle")
  tradeInFor  Sale[]        @relation("SaleTradeIn")

  @@unique([storeId, plate])
  @@index([published, status])
  @@index([storeId, position])
  @@index([brand, model])
  @@index([price])
}

/// Opcionais em tabela própria (permite filtrar por opcional no banco).
model VehicleFeature {
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  name      String  @db.VarChar(80)

  @@id([vehicleId, name])
  @@index([name])
}

model VehiclePhoto {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  url          String   @db.VarChar(255) // versão grande (1600px, WebP)
  thumbUrl     String   @db.VarChar(255) // miniatura (600px, WebP)
  originalPath String   @db.VarChar(255) // original privado, usado para refazer a marca d'água
  width        Int      @default(0)
  height       Int      @default(0)
  watermarked  Boolean  @default(false)
  position     Int      @default(0) // 0 = capa
  createdAt    DateTime @default(now())

  @@index([vehicleId, position])
}

model Lead {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  name      String   @db.VarChar(100)
  phone     String   @db.VarChar(20)
  email     String?  @db.VarChar(191)
  message   String?  @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

/// Gastos com o veículo (preparação, despachante, etc.)
model VehicleExpense {
  id          String          @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @default(OTHER)
  description String          @db.VarChar(200)
  amount      Decimal         @db.Decimal(12, 2)
  date        DateTime        @db.Date
  supplier    String?         @db.VarChar(120)
  fileRef     String?         @db.VarChar(255) // comprovante (arquivo privado)
  fileName    String?         @db.VarChar(160)
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([vehicleId, date])
}

/// Documentação do veículo (lista de verificação)
model VehicleDocument {
  id        String         @id @default(cuid())
  vehicleId String
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      DocumentType
  label     String?        @db.VarChar(80) // nome livre quando type = OTHER
  status    DocumentStatus @default(PENDING)
  expiresAt DateTime?      @db.Date
  notes     String?        @db.VarChar(255)
  fileRef   String?        @db.VarChar(255)
  fileName  String?        @db.VarChar(160)
  updatedAt DateTime       @updatedAt

  @@index([vehicleId])
  @@index([status, expiresAt])
}

/// IPVA, licenciamento e multas
model VehicleTax {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  kind        TaxKind
  description String?   @db.VarChar(200)
  amount      Decimal   @db.Decimal(12, 2)
  dueDate     DateTime? @db.Date
  paidAt      DateTime? @db.Date
  fileRef     String?   @db.VarChar(255)
  fileName    String?   @db.VarChar(160)
  createdAt   DateTime  @default(now())

  @@index([vehicleId])
  @@index([paidAt, dueDate])
}

/// Valor FIPE registrado mês a mês
model FipeHistory {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  month     String   @db.Char(7) // AAAA-MM
  reference String   @db.VarChar(40)
  value     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  @@unique([vehicleId, month])
}

/// Registro de quem fez o quê (inclui o admin agindo como loja)
model AuditLog {
  id        String   @id @default(cuid())
  storeId   String?
  userId    String?
  userName  String   @db.VarChar(100)
  asAdmin   Boolean  @default(false)
  action    String   @db.VarChar(60)
  entity    String?  @db.VarChar(40)
  entityId  String?  @db.VarChar(40)
  details   String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

/// Clientes da loja (compradores)
model Customer {
  id        String    @id @default(cuid())
  storeId   String
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(120)
  document  String?   @db.VarChar(14) // CPF ou CNPJ (só números)
  rg        String?   @db.VarChar(20)
  birthDate DateTime? @db.Date
  phone     String?   @db.VarChar(20)
  email     String?   @db.VarChar(191)
  zipCode   String?   @db.VarChar(8)
  address   String?   @db.VarChar(200) // rua e número
  district  String?   @db.VarChar(80)
  city      String?   @db.VarChar(80)
  state     String?   @db.Char(2)
  notes     String?   @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sales Sale[]

  @@unique([storeId, document])
  @@index([storeId, name])
}

/// Venda (ou reserva com sinal) de um veículo
model Sale {
  id               String     @id @default(cuid())
  number           Int // número sequencial por loja
  storeId          String
  store            Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vehicleId        String
  vehicle          Vehicle    @relation("SaleVehicle", fields: [vehicleId], references: [id], onDelete: Restrict)
  customerId       String
  customer         Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sellerId         String?
  sellerName       String     @db.VarChar(100)
  status           SaleStatus @default(COMPLETED)
  date             DateTime   @db.Date
  price            Decimal    @db.Decimal(12, 2) // valor final negociado
  commission       Decimal?   @db.Decimal(12, 2)
  warrantyDays     Int        @default(90)
  mileageAtSale    Int?
  notes            String?    @db.Text // condições adicionais (saem no contrato)
  tradeInVehicleId String?
  tradeInVehicle   Vehicle?   @relation("SaleTradeIn", fields: [tradeInVehicleId], references: [id], onDelete: SetNull)
  canceledAt       DateTime?
  cancelReason     String?    @db.VarChar(255)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  payments SalePayment[]

  @@unique([storeId, number])
  @@index([storeId, date])
  @@index([vehicleId])
}

model SalePayment {
  id      String        @id @default(cuid())
  saleId  String
  sale    Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method  PaymentMethod
  amount  Decimal       @db.Decimal(12, 2)
  details String?       @db.VarChar(200) // banco, nº de parcelas, veículo da troca...
  dueDate DateTime?     @db.Date
  paidAt  DateTime?     @db.Date

  @@index([saleId])
}
